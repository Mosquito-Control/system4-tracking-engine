# System 4 — Drone Tracking Engine environment variables

# Full connection string for droneadmin (read+write) on Azure PostgreSQL
DATABASE_URL=postgresql://droneadmin:<password>@drone-detection-pg.postgres.database.azure.com/dronedetection?sslmode=require

# Association parameters
ASSOC_DIST_M=50       # max metres from track's last point to associate a new detection
ASSOC_TIME_S=3.0      # max seconds between last track point and new detection
LOST_AFTER_S=10.0     # seconds of inactivity before a track is marked 'lost'
LOOP_INTERVAL_S=1.0   # tracker loop cadence in seconds
PURGE_AFTER_S=3600    # hard-delete tracks 'lost' longer than this (prevents table growth)
